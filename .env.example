# =============================================================================
# n8n-hubspot-deal-split-revenue-attribution-calculator — environment template
# -----------------------------------------------------------------------------
# Copy to your n8n host's environment (docker-compose `environment:`, a secrets
# manager, or a systemd EnvironmentFile). NEVER commit a filled-in copy.
# Every value below is a placeholder or a safe default. Values that still start
# with REPLACE_WITH_ are treated as "not configured" by calculator.js.
#
# n8n Code nodes read these through $env, so N8N_BLOCK_ENV_ACCESS_IN_NODE must be
# false on the host. If env access is blocked, the workflow falls back to the
# safe defaults (SANDBOX_MODE=true) and writes nothing.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true  = calculate and log a dry-run report only; no HubSpot, Sheets, DB or alert writes.
# false = live sync. Keep true until the Test Validation Protocol in README.md passes.
SANDBOX_MODE=true

# Shared secret for the alternative "Closed-Won Workflow Webhook" path. HubSpot
# workflows must send it in the x-split-secret header. Minimum 16 characters.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# --- HubSpot ------------------------------------------------------------------
# Used only to build record links in alerts. Not a credential.
HUBSPOT_PORTAL_ID=REPLACE_WITH_HUBSPOT_PORTAL_ID
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Comma-separated internal stage IDs that count as Closed-Won (one per pipeline).
CLOSED_WON_STAGE_IDS=closedwon
# Deal property holding the commissionable amount, and its currency code.
COMMISSION_BASE_PROPERTY=amount
CURRENCY_PROPERTY=deal_currency_code
DEFAULT_CURRENCY=USD

# --- Split model ----------------------------------------------------------------
# HALF_EVEN (banker's rounding, default) | HALF_UP | DOWN
ROUNDING_MODE=HALF_EVEN
# Allowed gap, in percentage points, between the sum of split percents and 100.
PERCENT_TOLERANCE=0.01
# true = scale any total to 100% instead of raising PERCENT_TOTAL_MISMATCH.
NORMALIZE_WEIGHTS=false
# Number of split slots (split_1_* … split_N_*) read from each deal. 1–20.
MAX_SPLIT_SLOTS=5
SPLIT_PROPERTY_PREFIX=split_
# When no slot is filled, credit 100% to the deal owner.
DEFAULT_OWNER_SPLIT=true
DEFAULT_ROLE=AE

# --- Partner channel carve-out -------------------------------------------------
ENABLE_PARTNER_ASSOCIATIONS=true
# Deal→company association label that marks a referral / channel partner.
PARTNER_ASSOCIATION_LABEL=Referral Partner
# Percent of the deal carved out for EACH labelled partner; reps share the rest.
PARTNER_DEFAULT_PERCENT=10

# --- Commission rates -----------------------------------------------------------
# Role → rate as decimal strings (0–1). Synthetic example values only.
COMMISSION_RATES_JSON={"AE":"0.10","SDR":"0.05","CSM":"0.03","SE":"0.02","PARTNER":"0.15"}
# Rate for roles not listed above.
DEFAULT_COMMISSION_RATE=0

# --- Run behaviour ---------------------------------------------------------------
WRITE_SLOT_PROPERTIES=true
FORCE_RECALCULATION=false
MAX_DEALS_PER_RUN=50

# --- Sync targets ------------------------------------------------------------------
ENABLE_HUBSPOT_WRITEBACK=true

ENABLE_GOOGLE_SHEETS=true
GOOGLE_SHEET_ID=REPLACE_WITH_GOOGLE_SHEET_ID
GOOGLE_SHEET_TAB=deal_splits

# Custom analytics database: the workflow POSTs JSON records to an ingest
# endpoint you control (see sql/schema.sql for the reference table).
ENABLE_ANALYTICS_INGEST=false
ANALYTICS_INGEST_URL=REPLACE_WITH_ANALYTICS_INGEST_URL

# --- Alerting -----------------------------------------------------------------------
ENABLE_ALERTS=true
ALERT_WEBHOOK_URL=REPLACE_WITH_ALERT_WEBHOOK_URL
# slack (Block Kit payload) | json (generic payload)
ALERT_FORMAT=slack

# =============================================================================
# REFERENCE ONLY — not read by the workflow.
# These belong in n8n's encrypted credential store, never in environment files
# that n8n Code nodes can read. Listed so operators know what to provision.
# =============================================================================
# HubSpot private app token  -> n8n credential "HubSpot App Token": REPLACE_WITH_HUBSPOT_PAT
# HubSpot developer app      -> n8n credential "HubSpot Developer API": REPLACE_WITH_HUBSPOT_DEVELOPER_API_KEY
# Google Sheets OAuth2       -> n8n credential "Google Sheets OAuth2": REPLACE_WITH_GOOGLE_OAUTH_CLIENT
# Analytics ingest token     -> n8n credential "Header Auth": REPLACE_WITH_ANALYTICS_API_TOKEN
# Analytics database (used by YOUR ingest service, not by n8n):
ANALYTICS_DATABASE_URL=REPLACE_WITH_ANALYTICS_DATABASE_URL
